{
  "name": "pace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:browser": "playwright test",
    "desktop": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --config electron-builder.json --win portable --x64 --publish never",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "test:electron": "npm run build && playwright test --config playwright.electron.config.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run lint && npm run format:check && npm run check:architecture && npm run typecheck && npm test",
    "graph:index": "codegraph index .",
    "graph:sync": "codegraph sync .",
    "graph:status": "codegraph status .",
    "graph:check": "node scripts/verify-codegraph.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.3.5"
  },
  "main": "desktop/main.cjs",
  "description": "PACE Revenue Analyst Learning Workspace",
  "author": "PACE",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnmmraadev/pace.git"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
